# Canopy configuration — full reference in docs/configuration.md
# Copy to web/.env.local for local dev, or use as --env-file for Docker.

# Vault (required: VAULT_BUCKET)
VAULT_ID=default
VAULT_BUCKET=my-vault-bucket
VAULT_PREFIX=
VAULT_REGION=us-east-1

# AWS credentials — leave blank to use the standard credential chain
# (instance role, ECS task role, IRSA, ~/.aws). Prefer roles over keys.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Bedrock — only used when FEATURE_AGENT / FEATURE_CURATE are on.
# Use the us./eu. cross-region inference profile matching your region.
BEDROCK_MODEL=us.amazon.nova-2-lite-v1:0
BEDROCK_REGION=us-east-1

# Curate Lambda — required only for FEATURE_CURATE (see infra/lambda/curate)
#CURATE_LAMBDA_ARN=
#CURATE_LAMBDA_REGION=us-east-1

# Default user id for personal-space paths (users/<id>/...).
# NEXT_PUBLIC_VAULT_USER_ID is inlined into the web build at build time;
# VAULT_USER_ID is the runtime equivalent for the Lambda and ingest CLI.
#NEXT_PUBLIC_VAULT_USER_ID=default
#VAULT_USER_ID=default

# Feature flags — every flag listed explicitly at its default so you can see
# exactly what a deployment can change at runtime. Defaults mirror
# web/lib/flags.ts and the published container image: ask-wiki agent ON,
# everything else OFF. Off-tokens: off/false/0/no/disabled (anything else,
# e.g. `on`, enables). FEATURE_EDITOR also gates the agent saving proposed
# pages. Full reference: docs/feature-flags.md
FEATURE_AGENT=on
FEATURE_UPLOAD=off
FEATURE_CURATE=off
FEATURE_REINDEX=off
FEATURE_EDITOR=off
FEATURE_SEARCH=off
FEATURE_STAR=off
FEATURE_PUBLISHING=off
FEATURE_IMAGE_PROXY=off

# Vault mode — how the portal recognizes and organizes documents. Usually
# leave unset: the mode is sniffed from the bucket contents (managed marker →
# structure.json → generated/authored content → folders). Set explicitly to
# pin it: folders | provenance | managed. See docs/configuration.md.
#VAULT_MODE=

# Chat rate limit (FEATURE_AGENT) — max POST /api/chat requests per minute
# per principal (session subject, else client IP). Every chat request invokes
# Bedrock, so this is the cost backstop. Default 20; 0/off disables.
#CHAT_RATE_LIMIT=20

# Uploads (FEATURE_UPLOAD) — max accepted size in bytes for POST /api/upload.
# Larger files are rejected with 413. Default 2 MiB.
#UPLOAD_MAX_BYTES=2097152

# Authentication (auth gate) — OFF by default (open portal). Set AUTH_MODE=oidc
# to require sign-in via any OIDC provider (Keycloak and AWS Cognito verified).
# Access control is delegated to the identity provider: whoever can
# authenticate is admitted, so restrict who exists in the IdP (e.g. the
# Cognito User Pool). There is no application-level allowlist.
# Full recipes: docs/configuration.md
#AUTH_MODE=oidc
#OIDC_ISSUER=https://keycloak.example.com/realms/canopy
#OIDC_CLIENT_ID=canopy
#OIDC_CLIENT_SECRET=
# High-entropy (>= 32 chars), e.g. `openssl rand -hex 32`. Rotating it logs everyone out.
#AUTH_SESSION_SECRET=

# Theming — drop-in CSS theme plugins. Full guide: docs/theming.md
# Directory scanned for *.css theme files (default: web/themes).
#THEME_DIR=
# Optional S3 prefix (in the vault bucket) scanned for *.css themes, so a
# built container can self-load themes on start with no rebuild or mount.
# Operator-only: no portal route can write a .css object. See docs/theming.md.
#THEME_VAULT_PREFIX=_themes/
# Server-side default theme id (built-in light/dark or a plugin filename slug).
#THEME_DEFAULT=dark

# Debugging
#DEBUG_AGENT=1
# Trace every S3 object operation (GET/PUT/DELETE/LIST). The resolved S3
# runtime config (bucket, prefix, region, useMock) is logged at startup
# regardless of this flag.
#DEBUG_S3=1
