{
  "name": "canopy",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@10.5.0",
  "scripts": {
    "dev": "pnpm --filter @canopy/web dev",
    "dev:mock": "MOCK_S3=1 VAULT_BUCKET=mock-bucket pnpm --filter @canopy/web dev",
    "seed:openwiki": "node scripts/seed-openwiki.mjs",
    "build": "pnpm --filter @canopy/web build",
    "lint": "pnpm --filter @canopy/web lint",
    "typecheck": "pnpm --filter @canopy/web typecheck",
    "test:unit": "pnpm --filter @canopy/web test",
    "ingest": "pnpm --filter @canopy/ingest start",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "playwright": "^1.62.1"
  },
  "pnpm": {
    "overrides": {
      "js-yaml@<3.15.0": "^3.15.0"
    }
  }
}
